{
  "name": "faultkit",
  "version": "1.2.1",
  "description": "Framework-agnostic, OpenAPI-compliant error handling and cloud-native structured logging (Pino/Loki) for TypeScript and Node.js backends.",
  "author": "Sahil Sharma <sahilsharma3043@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sahil-coder-30/faultkit.git"
  },
  "bugs": {
    "url": "https://github.com/Sahil-coder-30/faultkit/issues"
  },
  "homepage": "https://github.com/Sahil-coder-30/faultkit#readme",
  "keywords": [
    "faultkit",
    "fault-tolerance",
    "error-handler",
    "typescript",
    "express",
    "openapi",
    "pino",
    "grafana-loki",
    "structured-logging",
    "agent-native",
    "agent-skills",
    "ai-ready",
    "monorepo",
    "microservices"
  ],
  "bin": {
    "faultkit": "bin/faultkit.js",
    "faultguard": "bin/faultguard.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "examples",
    "CHANGELOG.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "express": [
        "./dist/types/express.d.ts"
      ],
      "logger": [
        "./dist/types/logger.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./express": {
      "types": "./dist/types/express.d.ts",
      "import": "./dist/esm/express.js",
      "require": "./dist/cjs/express.js"
    },
    "./logger": {
      "types": "./dist/types/logger.d.ts",
      "import": "./dist/esm/logger.js",
      "require": "./dist/cjs/logger.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('./dist/cjs/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('./dist/esm/package.json', JSON.stringify({type:'module'},null,2))\"",
    "build:types": "tsc -p tsconfig.types.json",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "dev": "tsc -p tsconfig.cjs.json --watch",
    "typecheck": "tsc --noEmit -p tsconfig.types.json",
    "test:types": "tsc --noEmit --strict --esModuleInterop --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 tests/adversarial/12_type_level.test.ts tests/express.test.ts tests/index.test.ts examples/01-express-production/server.ts examples/02-structured-logging-tracing/logging.ts examples/03-domain-custom-errors/customErrors.ts examples/04-framework-agnostic/fastify-or-lambda.ts",
    "test": "npm run test:unit && npm run test:cli && npm run test:e2e && npm run test:fixes",
    "test:unit": "node tests/unit.js",
    "test:cli": "node tests/cli.test.js",
    "test:e2e": "node tests/e2e/runner.js",
    "test:fixes": "node tests/fixes_v1_2.test.js",
    "test:logger": "node tests/logger.test.js",
    "test:stress": "node tests/stress_logger_standalone.test.js && node tests/stress_errorhandler_standalone.test.js && node tests/stress_combined_e2e.test.js",
    "test:stress:logger": "node tests/stress_logger_standalone.test.js",
    "test:stress:handler": "node tests/stress_errorhandler_standalone.test.js",
    "test:stress:combined": "node tests/stress_combined_e2e.test.js",
    "test:adversarial": "node tests/adversarial/runner.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^4.22.3",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pino": "^10.4.0"
  }
}
